{
  "manifest_version": 3,
  "name": "MailGuard AI — Spam Detector",
  "version": "2.1.0",
  "description": "Local NLP-powered email spam detection and security analysis.",
  "permissions": ["storage", "activeTab", "scripting", "notifications"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*", "<all_urls>"],
  "action": {"default_popup": "popup/popup.html", "default_title": "MailGuard AI"},
  "background": {"service_worker": "background/service-worker.js"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}],
  "options_page": "options/options.html",
  "icons": {"16":"assets/icon16.png","48":"assets/icon48.png","128":"assets/icon128.png"}
}
